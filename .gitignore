# --- Node / Electron ---
node_modules/
dist/
dist-electron/
out/
release/
.vite/
*.log
npm-debug.log*

# --- Python サイドカー ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
build/

# --- 大きすぎてコミットしないもの ---
