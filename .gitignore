# --- Node / Electron ---
node_modules/
dist/
dist-electron/
dist-sidecar/
build-sidecar/
out/
release/
.vite/
*.log
npm-debug.log*

# --- Python サイドカー ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
build/

# --- 大きすぎてコミットしないもの ---
# モデルの重み（初回セットアップでDLする）
models/
*.bin
*.gguf
*.mlmodelc/
*.onnx
# ffmpeg バイナリ（OS別に vendoring するがコミットはしない）
vendor/ffmpeg/

# 顔検出モデル（Apache-2.0。scripts/fetch_models.py で取得）
vendor/models/

# フォント（SIL OFL で再配布可だが、scripts/fetch_fonts.py で取得するので commit しない）
assets/fonts/*.ttf
assets/fonts/*.otf
# ライセンス全文もフォントと一緒に取得する（配布物には入るが commit はしない）
assets/fonts/licenses/

# --- 作業ファイル ---
tmp/
temp/
.cache/
proxies/
exports/
*.tmp

# 🔴 動画・音声は一切コミットしない。
# テスト素材は scripts/make_test_media.py で生成する（samples/README.md）。
*.mp4
*.mov
*.mkv
*.wav
*.m4a

# 🔴 実素材（友達が映っているもの）を置く場所。絶対に commit しない。
fixtures-local/

# 🔴 設計レポート。手元には残すが、公開リポジトリには入れない。
#    収益化の方針まで書いてあるので、履歴からも除いてある（git filter-repo）。
#    戻したくなったら、この行を消す前に中身を読み直すこと。
docs/design-report.md
docs/design-report-v1.md

# --- Phase 0 の検証結果に付随する生成物 ---
phase0-artifacts/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- 秘密情報 ---
.env
.env.local
*.pem
