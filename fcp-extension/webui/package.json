{
  "name": "pac-fcp-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PAC の Final Cut Pro パネル用 UI。PAC 本体とは独立した別プロジェクト。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:split": "node --experimental-strip-types test/split-telop.mjs",
    "test:strip": "node --experimental-strip-types test/filmstrip-step.mjs",
    "test": "npm run test:split && npm run test:join && npm run test:pause && npm run test:strip",
    "test:join": "node --experimental-strip-types test/join-telop.mjs",
    "test:pause": "node --experimental-strip-types test/pause-split.mjs"
  },
  "dependencies": {
    "budoux": "^0.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
