{
  "name": "ai-video-editor",
  "version": "0.0.0",
  "private": true,
  "description": "ショート動画向けAI動画編集アプリ（カット/テロップ/ズームの自動提案 → 人間が承認して書き出し）",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "guard": "node scripts/platform-guard.mjs",
    "test:drafts": "node scripts/test-drafts.mjs",
    "test:telop": "node scripts/test-telop.mjs",
    "test:track": "python scripts/test_telop_track.py",
    "test:graph": "python scripts/test_export_graph.py",
    "test:clip": "python scripts/test_review_clip.py",
    "test:cut": "python scripts/test_cut_confidence.py",
    "test:fcpxml": "python scripts/test_fcpxml.py",
    "smoke": "electron . --smoke-test",
    "t1": "electron . --t1-wysiwyg",
    "t2": "electron . --t2-budoux",
    "t4": "electron . --t4-sidecar",
    "sidecar:dev": "python -m sidecar",
    "t5": "electron . --t5-telop",
    "sidecar:build": "pyinstaller packaging/sidecar.spec --noconfirm --distpath dist-sidecar --workpath build-sidecar",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1"
  },
  "dependencies": {
    "budoux": "^0.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "jp.touei.ai-video-editor",
    "productName": "AI動画編集",
    "copyright": "",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-sidecar/sidecar",
        "to": "sidecar"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/models",
        "to": "sidecar/models"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "darkModeSupport": true,
      "identity": null,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "編集する動画を読み込み、作業用のファイルを作るために使います。",
        "NSDocumentsFolderUsageDescription": "編集する動画を読み込み、作業用のファイルを作るために使います。",
        "NSDownloadsFolderUsageDescription": "編集する動画を読み込み、作業用のファイルを作るために使います。",
        "NSRemovableVolumesUsageDescription": "外付けドライブにある動画を編集するために使います。"
      }
    },
    "dmg": {
      "title": "AI動画編集",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
