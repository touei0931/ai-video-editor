{
  "name": "ai-video-editor",
  "version": "0.0.0",
  "private": true,
  "description": "ショート動画向けAI動画編集アプリ（カット/テロップ/ズームの自動提案 → 人間が承認して書き出し）",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "guard": "node scripts/platform-guard.mjs",
    "test:drafts": "node scripts/test-drafts.mjs",
    "test:graph": "python scripts/test_export_graph.py",
    "test:clip": "python scripts/test_review_clip.py",
    "smoke": "electron . --smoke-test",
    "t1": "electron . --t1-wysiwyg",
    "t2": "electron . --t2-budoux",
    "t4": "electron . --t4-sidecar",
    "sidecar:dev": "python -m sidecar",
    "t5": "electron . --t5-telop"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1"
  },
  "dependencies": {
    "budoux": "^0.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
