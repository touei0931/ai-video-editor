# テスト素材（Phase 0 T0）は Git LFS で管理する
samples/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
samples/**/*.mov filter=lfs diff=lfs merge=lfs -text
samples/**/*.wav filter=lfs diff=lfs merge=lfs -text

# 改行コードは LF に統一（Windows で開発し macOS でビルドするため）
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
